# Upstash Redis REST endpoint + token — auto-injected when you provision
# Upstash Redis through the Vercel Marketplace. For local dev, copy them
# from the Upstash console (REST API section).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app credentials — from github.com → Settings → Developer
# settings → OAuth Apps → your app.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Your numeric GitHub user id (NOT username) — find it at
# https://api.github.com/users/<your-username> in the "id" field.
# Only this GitHub identity can sign in.
ALLOWED_GITHUB_ID=

# Encrypts Stripe secret keys stored in Redis (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Set once. Rotating it invalidates stored Stripe keys — you would have to
# re-enter each key in the app.
ENCRYPTION_SECRET=
